# 监听地址：仅本机访问使用 127.0.0.1，需要其他设备访问时改为 0.0.0.0。
HOST=127.0.0.1
# HTTP 端口。
PORT=3001
# 公开部署时启用生产模式，并先配置下面两项口令与密钥。
# NODE_ENV=production
# 管理口令：生产模式至少 12 个字符。
# ADMIN_PASSPHRASE=请替换为至少12个字符的独立管理口令
# 签名密钥：生产模式至少 32 个字符，请使用随机生成的密钥。
# MAGIC_SCHOOL_SECRET=请替换为至少32个字符的随机签名密钥
# 持久化数据目录，省略时使用 server/data/。
# MAGIC_DATA_DIR=/path/to/raincourt-data
# 设置为 1 时使用构建后的 dist/ 资源；需要先运行 npm run build。
# SERVE_DIST=1

# 学院影像播放方式：local（本地视频）、direct（视频直链）、bilibili（哔哩哔哩嵌入）。
# 修改配置后重启服务；下面三项链接只读取当前播放方式对应的一项。
# 视频配置缺失或无效时只停用学院影像，服务继续运行，原因会显示在启动日志中。
FILM_MODE=local

# 本地视频：填写以 / 开头的本站路径，文件放在 web/ 对应目录中。
FILM_LOCAL_URL=/media/promo/magaambya-promo.webm

# 视频直链：填写可直接返回视频文件的完整 HTTP/HTTPS 链接，不是视频详情页。
# 示例：https://cdn.example.com/magaambya-promo.webm（将域名与路径替换为实际地址）。
# 也支持浏览器原生可播放的 MP4 等格式；HTTPS 网站应填写 HTTPS 直链。
# 如直链有跳转，请填写最终视频地址，以匹配本站媒体来源设置。
FILM_DIRECT_URL=

# 哔哩哔哩：填写视频页面链接或外链播放器的 src 链接，不要粘贴整段 iframe 代码。
# 视频页面示例：https://www.bilibili.com/video/BV1B7411m7LV/?p=1
# 嵌入链接示例：https://player.bilibili.com/player.html?bvid=BV1B7411m7LV&p=1&autoplay=1
# 上述 BV 号仅为格式示例，请替换为实际学院影像的 BV 号；p 为分 P 编号。
FILM_BILIBILI_URL=
